// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Platform role. Null = standard user. "SUPERADMIN" = platform
  // administrator. Nullable (not an enum, not defaulted) so normal users
  // carry no admin marker, and so the column stays compatible with the
  // Better Auth user model, which ignores unknown columns. Never infer
  // this from email/domain — set only via explicit server-side bootstrap.
  // Organization roles live on Member, never here.
  platformRole  String?

  accounts    Account[]
  sessions    Session[]
  members     Member[]
  invitations Invitation[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id        String   @id
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Business profile (Organization → Business Profile). All nullable:
  // the organization row is created at registration before any profile
  // details exist. Logos stay out of the database until asset storage
  // lands — `logo` only ever holds a served URL, never pasted uploads.
  businessType     String?
  industry         String?
  website          String?
  tagline          String?
  contactEmail     String?
  phone            String?
  altPhone         String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  pinCode          String?
  country          String?
  primaryColor     String?
  secondaryColor   String?
  brandTagline     String?
  brandDescription String?
  fontStyle        String?
  layoutStyle      String?

  members     Member[]
  invitations Invitation[]
  locations   Location[]
  departments Department[]
  locationDepartments LocationDepartment[]
  assetCategories AssetCategory[]
  assetModels AssetModel[]
  assets Asset[]
  assetAssignments AssetAssignment[]
  assetHistory AssetHistory[]

  // Comprehensive Organization Profile fields
  legalName          String?
  description        String?
  establishedDate    DateTime?
  status             String?  @default("active")

  // Legal & Tax Identification
  gstin              String?
  pan                String?
  cin                String?
  businessIdentifier String?

  addresses          OrganizationAddress[]
  settings           OrganizationSettings?

  @@map("organization")
}

model OrganizationAddress {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String       @default("registered")
  label          String?
  addressLine1   String
  addressLine2   String?
  landmark       String?
  city           String
  district       String?
  state          String
  stateCode      String?
  country        String       @default("India")
  postalCode     String
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, type])
  @@map("organization_address")
}

model OrganizationSettings {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  displayName    String?
  timezone       String       @default("Asia/Kolkata")
  locale         String       @default("en-IN")
  dateFormat     String       @default("DD/MM/YYYY")
  timeFormat     String       @default("12h")
  currency       String       @default("INR")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("organization_settings")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  assetAssignments AssetAssignment[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("member")
}

model Invitation {
  id             String   @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String
  status         String   @default("pending")
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  inviterId      String
  inviter        User     @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  // SHA-256 hex of the acceptance token. Nullable so pre-token rows stay
  // valid; acceptance requires a non-null hash. The raw token is emailed
  // once and never persisted.
  tokenHash      String?  @unique

  @@index([email])
  @@index([organizationId])
  @@map("invitation")
}

// Atomic rate-limit ledger for custom API throttling. Rows are written
// inside an advisory-locked transaction (count-then-insert is race-safe);
// stale rows are pruned lazily. Never read for business logic.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("rate_limit_hit")
}

// Operational site belonging to exactly one organization. Soft-deactivated
// via isActive (rows and assignments are preserved); at most one default
// per organization, transitioned atomically in the repository.
model Location {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  description    String?
  email          String?
  phone          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String?
  timezone       String?
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignments    LocationDepartment[]
  assetAssignments AssetAssignment[]
  currentAssets Asset[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("location")
}
// Organizational unit belonging to exactly one organization. Departments
// may exist without any location assignment. Soft-deactivated via
// isActive; assignments are preserved across deactivation cycles.
model Department {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignments    LocationDepartment[]
  assetAssignments AssetAssignment[]
  currentAssets Asset[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("department")
}

// Many-to-many assignment between a location and a department within the
// same organization. organizationId is denormalized so tenant isolation
// holds without joining parents. Removing a row never deletes either side.
model LocationDepartment {
  id             String     @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt      DateTime   @default(now())

  @@unique([locationId, departmentId])
  @@index([organizationId])
  @@index([locationId])
  @@index([departmentId])
  @@map("location_department")
}

// Asset category scoped to one organization. Category codes (and names)
// are unique within the organization. Deactivation is soft (isActive);
// categories are never hard-deleted while assets reference them.
model AssetCategory {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  models AssetModel[]
  assets Asset[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("asset_category")
}

// Asset model (make/brand + model) within a category and organization.
// Brand + model name is unique per organization; an optional model code
// is unique per organization when present (NULLs stay distinct).
model AssetModel {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  categoryId     String
  category       AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand          String
  modelName      String
  modelCode      String?
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assets Asset[]

  @@unique([organizationId, brand, modelName])
  @@unique([organizationId, modelCode])
  @@index([organizationId])
  @@index([categoryId])
  @@index([organizationId, isActive])
  @@map("asset_model")
}

// Physical/trackable IT asset. Monetary amounts use Decimal — never
// floating point. `status` tracks the lifecycle (AVAILABLE, ASSIGNED,
// MAINTENANCE, RETIRED); `archivedAt` is soft archival and excludes the
// asset from active counts and default listings. `activeAssignmentId` is
// a nullable unique pointer to the single open assignment; NULLs stay
// distinct so only the conditional-update guard plus this constraint
// together prevent concurrent duplicate active assignments.
model Asset {
  id                 String    @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assetTag           String
  name               String
  description        String?
  categoryId         String
  category           AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  modelId            String?
  model              AssetModel? @relation(fields: [modelId], references: [id], onDelete: Restrict)
  brand              String?
  serialNumber       String?
  purchaseDate       DateTime
  purchaseCost       Decimal   @db.Decimal(14, 2)
  currency           String    @default("INR")
  vendorName         String?
  invoiceNumber      String?
  warrantyStartDate  DateTime?
  warrantyEndDate    DateTime?
  condition          String    @default("GOOD")
  status             String    @default("AVAILABLE")
  currentLocationId  String?
  currentLocation    Location? @relation(fields: [currentLocationId], references: [id], onDelete: Restrict)
  currentDepartmentId String?
  currentDepartment  Department? @relation(fields: [currentDepartmentId], references: [id], onDelete: Restrict)
  activeAssignmentId String?   @unique
  activeAssignment   AssetAssignment? @relation("ActiveAssignment", fields: [activeAssignmentId], references: [id], onDelete: SetNull)
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignments AssetAssignment[] @relation("AssetAssignments")
  history     AssetHistory[]

  @@unique([organizationId, assetTag])
  @@unique([organizationId, serialNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([categoryId])
  @@index([modelId])
  @@index([currentLocationId])
  @@index([organizationId, archivedAt])
  @@map("asset")
}

// Historical assignment record. One row per handover; `returnedAt`
// closes it. Names are snapshotted at assignment time so later renames
// of members, locations or departments never rewrite history. The live
// membership link is nullable with SetNull: removing a member must not
// destroy assignment history.
model AssetAssignment {
  id               String    @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assetId          String
  asset            Asset     @relation("AssetAssignments", fields: [assetId], references: [id], onDelete: Restrict)
  membershipId     String?
  membership       Member?   @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  assigneeUserId   String
  assigneeName     String
  assigneeEmail    String
  locationId       String
  location         Location  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  locationName     String
  departmentId     String?
  department       Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  departmentName   String?
  assignedAt       DateTime  @default(now())
  expectedReturnAt DateTime?
  returnedAt       DateTime?
  assignmentCondition String @default("GOOD")
  returnCondition  String?
  notes            String?
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  activeForAsset Asset? @relation("ActiveAssignment")

  @@index([organizationId])
  @@index([assetId])
  @@index([organizationId, assetId])
  @@index([membershipId])
  @@map("asset_assignment")
}

// Queryable per-asset event log backing the detail history timeline and
// assignment reporting. Complements (never replaces) the stdout security
// audit log: this table is readable history, the audit logger remains the
// tamper-evident security trail. Rows are immutable (no updatedAt).
model AssetHistory {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assetId        String?
  asset          Asset?   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  eventType      String
  actorUserId    String?
  summary        String
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([assetId])
  @@index([organizationId, assetId])
  @@map("asset_history")
}
